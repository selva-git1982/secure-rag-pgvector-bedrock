DATABASE_URL=postgresql://rag:local_dev_only@localhost:5432/rag
# Generate a long random secret for local JWT validation; never commit it.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=secure-rag-demo
JWT_AUDIENCE=secure-rag-api
EMBEDDING_PROVIDER=local
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Optional: generation is disabled unless explicitly enabled.
ENABLE_GENERATION=false
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
